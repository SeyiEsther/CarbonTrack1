<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CarbonTrack</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'DM Sans',sans-serif;overflow:hidden}
body{
  background:linear-gradient(145deg,#2a1228 0%,#3A1C36 40%,#4d2e52 60%,#374126 100%);
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:100vh;
  position:relative;
}
.orb{position:absolute;border-radius:50%;pointer-events:none}
.orb1{width:550px;height:550px;top:-20%;right:-10%;background:radial-gradient(ellipse,rgba(155,113,178,0.35) 0%,transparent 65%)}
.orb2{width:450px;height:450px;bottom:-20%;left:-8%;background:radial-gradient(ellipse,rgba(108,109,17,0.25) 0%,transparent 65%)}
.card{
  position:relative;z-index:1;
  width:380px;
  background:rgba(255,255,255,0.07);
  backdrop-filter:blur(40px);
  -webkit-backdrop-filter:blur(40px);
  border:1px solid rgba(255,255,255,0.13);
  border-radius:28px;
  padding:44px 38px;
  box-shadow:0 40px 80px rgba(0,0,0,0.35),inset 0 1px 0 rgba(255,255,255,0.18);
}
.logo{display:flex;align-items:center;gap:7px;margin-bottom:32px}
.logo-dot{width:7px;height:7px;background:#E3D0EA;border-radius:50%}
.logo-name{font-family:'DM Serif Display',serif;font-size:16px;color:rgba(255,255,255,0.8);letter-spacing:-0.01em}
.card-title{font-family:'DM Serif Display',serif;font-size:40px;color:#fff;line-height:1;letter-spacing:-0.02em;margin-bottom:32px}
.card-title em{font-style:italic;color:#E3D0EA}
.field{margin-bottom:12px}
.field-inner{
  background:rgba(255,255,255,0.07);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:14px;
  padding:14px 18px;
  display:flex;
  align-items:center;
  gap:10px;
  transition:all .2s;
}
.field-inner:focus-within{
  background:rgba(255,255,255,0.11);
  border-color:rgba(227,208,234,0.3);
  box-shadow:0 0 0 3px rgba(155,113,178,0.1);
}
.field-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,0.25);margin-bottom:5px;display:block}
.field-input{
  flex:1;background:none;border:none;outline:none;
  font-size:14px;color:#fff;
  font-family:'DM Sans',sans-serif;font-weight:300;
}
.field-input::placeholder{color:rgba(255,255,255,0.2)}
.forgot{font-size:11px;color:rgba(255,255,255,0.2);cursor:pointer;white-space:nowrap;text-decoration:none;transition:color .2s}
.forgot:hover{color:rgba(255,255,255,0.45)}
.btn{
  width:100%;margin-top:20px;
  background:rgba(227,208,234,0.9);
  color:#3A1C36;
  border:none;border-radius:14px;
  padding:15px;
  font-size:14px;font-weight:600;
  cursor:pointer;
  font-family:'DM Sans',sans-serif;
  transition:all .2s;
  letter-spacing:0.01em;
}
.btn:hover{background:#fff;transform:translateY(-1px);box-shadow:0 10px 30px rgba(0,0,0,0.25)}
.btn:active{transform:translateY(0)}
.card-foot{
  margin-top:28px;
  padding-top:20px;
  border-top:1px solid rgba(255,255,255,0.06);
  display:flex;align-items:center;justify-content:space-between;
}
.founding{display:inline-flex;align-items:center;gap:5px;background:rgba(108,109,17,0.18);border:1px solid rgba(108,109,17,0.22);border-radius:100px;padding:3px 10px}
.f-dot{width:4px;height:4px;background:#b4b82a;border-radius:50%}
.f-text{font-size:9px;color:#c8cc3a;font-weight:600;letter-spacing:.05em;text-transform:uppercase}
.help{font-size:11px;color:rgba(255,255,255,0.18);text-decoration:none;transition:color .2s}
.help:hover{color:rgba(255,255,255,0.4)}
</style>
</head>
<body>
<div class="orb orb1"></div>
<div class="orb orb2"></div>
<div class="card">
  <div class="logo">
    <div class="logo-dot"></div>
    <span class="logo-name">CarbonTrack</span>
  </div>
  <h1 class="card-title">Log <em>in.</em></h1>
  <form action="/Dashboard/Index" method="get">
    <div class="field">
      <label class="field-label">Email address</label>
      <div class="field-inner">
        <input class="field-input" type="email" placeholder="you@company.co.uk" />
      </div>
    </div>
    <div class="field">
      <label class="field-label">Password</label>
      <div class="field-inner">
        <input class="field-input" type="password" placeholder="••••••••" />
        <a href="#" class="forgot">forgot</a>
      </div>
    </div>
    <button type="submit" class="btn">Sign in →</button>
  </form>
  <div class="card-foot">
    <div class="founding">
      <div class="f-dot"></div>
      <span class="f-text">Founding Member</span>
    </div>
    <a href="mailto:seyi@usecarbontrack.co.uk" class="help">Need help?</a>
  </div>
</div>
</body>
</html>