@model IEnumerable<CarbonTrack.Models.Trip>
@using CarbonTrack.Controllers

@{
    ViewData["Title"] = "Reports";
    Layout = "_Layout";
    var trips = Model ?? Enumerable.Empty<CarbonTrack.Models.Trip>();
    var now = DateTime.UtcNow;
}

@if (ViewBag.Success != null)
{
    <div style="background:rgba(92,122,90,0.15);border:1px solid rgba(92,122,90,0.3);border-radius:8px;padding:14px;margin-bottom:20px;color:#8aac87;font-size:13px;">✓ @ViewBag.Success</div>
}
@if (ViewBag.Error != null)
{
    <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:14px;margin-bottom:20px;color:#fca5a5;font-size:13px;"><strong>Error:</strong> @ViewBag.Error</div>
}

<!-- ═══════════════════════════════════════════════════════
     SCREEN LAYOUT
════════════════════════════════════════════════════════ -->
<div class="screen-only">

    <!-- Report header bar -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px;gap:16px;flex-wrap:wrap">
        <div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
                <div style="width:3px;height:32px;background:var(--lv);border-radius:2px"></div>
                <h1 class="page-title" style="margin:0">Emissions Report</h1>
            </div>
            <p style="font-size:13px;color:var(--txm);margin-left:13px">
                DEFRA 2025 · Scope 3 Cat 6 & 7 · All time ·
                Generated <strong style="color:var(--tx)">@now.ToString("dd MMM yyyy")</strong>
            </p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <a href="/Reports/ExportCsv" class="xbtn xbtn-green">↓ CSV</a>
            <a href="/Reports/ExportExcel" class="xbtn xbtn-lv">↓ Excel</a>
            <button onclick="window.print()" class="xbtn xbtn-ghost">⎙ Print audit PDF</button>
        </div>
    </div>

    <!-- Top KPI row — distinct from dashboard -->
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:12px;margin-bottom:24px">
        <div style="background:var(--bg2);border:1px solid var(--bda);border-radius:14px;padding:22px 26px;display:flex;align-items:center;gap:20px">
            <div style="width:48px;height:48px;border-radius:12px;background:rgba(197,180,227,0.12);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">🌍</div>
            <div>
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--txm);margin-bottom:4px">Total Scope 3 Cat 6&7</div>
                <div style="font-family:'DM Serif Display',serif;font-size:38px;line-height:1;color:var(--tx)">@ViewBag.TotalTCO2e</div>
                <div style="font-size:11px;color:var(--txm);margin-top:2px">tCO₂e all time</div>
            </div>
        </div>
        <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;padding:18px 20px">
            <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--txm);margin-bottom:8px">Total trips</div>
            <div style="font-size:32px;font-weight:600;color:var(--tx);line-height:1">@ViewBag.TotalTrips</div>
            <div style="font-size:11px;color:var(--txm);margin-top:4px">journeys logged</div>
        </div>
        <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;padding:18px 20px">
            <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--txm);margin-bottom:8px">Total distance</div>
            <div style="font-size:32px;font-weight:600;color:var(--tx);line-height:1">@(((double)ViewBag.TotalKm).ToString("N0"))</div>
            <div style="font-size:11px;color:var(--txm);margin-top:4px">kilometres</div>
        </div>
        <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;padding:18px 20px">
            <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--txm);margin-bottom:8px">DEFRA version</div>
            <div style="font-size:32px;font-weight:600;color:var(--lv);line-height:1">2025</div>
            <div style="font-size:11px;color:var(--txm);margin-top:4px">factors current</div>
        </div>
    </div>

    <!-- Mode breakdown + Top routes side by side -->
    <div style="display:grid;grid-template-columns:3fr 2fr;gap:16px;margin-bottom:24px">

        <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;overflow:hidden">
            <div style="padding:16px 20px;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between">
                <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--txm)">Emissions by transport mode</span>
                <span class="lv-badge">DEFRA 2025 ✓</span>
            </div>
            <table>
                <thead><tr>
                    <th>Mode</th><th>Trips</th><th>km</th><th>kgCO₂e</th><th>tCO₂e</th><th>Share</th>
                </tr></thead>
                <tbody>
                    @{
                        double totalKg = trips.Sum(t => t.KgCO2e);
                    }
                    @foreach (ModeRow row in (ViewBag.ModeBreakdown ?? new List<ModeRow>()))
                    {
                        double pct = totalKg > 0 ? Math.Round(row.TotalKg / totalKg * 100, 1) : 0;
                        <tr>
                            <td><span class="tag @(row.Mode.StartsWith("Flight") ? "tag-flight" : row.Mode.StartsWith("Train") ? "tag-train" : "tag-car")">@row.Mode</span></td>
                            <td class="mono">@row.Count</td>
                            <td class="mono">@row.TotalKm.ToString("N0")</td>
                            <td class="co2">@row.TotalKg.ToString("N2")</td>
                            <td class="mono">@row.TotalT</td>
                            <td style="min-width:80px">
                                <div style="display:flex;align-items:center;gap:6px">
                                    <div style="flex:1;height:4px;background:var(--bd);border-radius:2px;overflow:hidden">
                                        <div style="height:100%;width:@pct%;background:var(--lv);border-radius:2px"></div>
                                    </div>
                                    <span style="font-size:10px;color:var(--txm);width:32px;text-align:right">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!trips.Any())
                    {
                        <tr><td colspan="6" style="text-align:center;padding:32px;color:var(--txm)">No trips yet</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;overflow:hidden">
            <div style="padding:16px 20px;border-bottom:1px solid var(--bd)">
                <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--txm)">Top routes by emissions</span>
            </div>
            <table>
                <thead><tr><th>Route</th><th>Trips</th><th>tCO₂e</th></tr></thead>
                <tbody>
                    @foreach (RouteRow row in (ViewBag.TopRoutes ?? new List<RouteRow>()))
                    {
                        <tr>
                            <td style="font-size:11px"><strong>@row.Route</strong></td>
                            <td class="mono">@row.Count</td>
                            <td class="co2">@row.TotalT</td>
                        </tr>
                    }
                    @if (!trips.Any())
                    {
                        <tr><td colspan="3" style="text-align:center;padding:32px;color:var(--txm)">No trips yet</td></tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- Full audit table -->
    <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;overflow:hidden">
        <div style="padding:16px 20px;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between">
            <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--txm)">Full audit trail — @trips.Count() trips</span>
            <div style="display:flex;gap:8px">
                <a href="/Reports/ExportCsv" class="xbtn xbtn-green" style="font-size:10px;padding:5px 10px">↓ CSV</a>
                <a href="/Reports/ExportExcel" class="xbtn xbtn-lv" style="font-size:10px;padding:5px 10px">↓ Excel</a>
            </div>
        </div>
        @if (!trips.Any())
        {
            <div style="text-align:center;padding:60px;color:var(--txm)">
                <p style="font-size:15px;margin-bottom:8px">No trips logged yet</p>
                <a href="/Trip/LogTrip" class="btn-primary">Log first trip</a>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table style="min-width:900px">
                    <thead><tr>
                        <th>Date</th><th>Route</th><th>Mode</th><th>Pax</th>
                        <th>Distance (km)</th><th>EF</th><th>Formula</th><th>kgCO₂e</th><th>Methodology</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var t in trips)
                        {
                            <tr>
                                <td style="color:var(--txm);white-space:nowrap">@t.TripDate.ToString("dd MMM yyyy")</td>
                                <td style="white-space:nowrap"><strong>@t.Origin → @t.Destination</strong></td>
                                <td><span class="tag @(t.TransportMode.StartsWith("Flight") ? "tag-flight" : t.TransportMode.StartsWith("Train") ? "tag-train" : "tag-car")">@t.TransportMode</span></td>
                                <td class="mono">@t.Passengers</td>
                                <td class="mono">@t.DistanceKm.ToString("N2")</td>
                                <td class="mono">@t.EmissionFactor</td>
                                <td class="mono" style="font-size:10px">@t.Formula</td>
                                <td class="co2">@t.KgCO2e.ToString("N2")</td>
                                <td><span class="ok-badge">@t.DistanceMethodology</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div><!-- end screen-only -->


<!-- ═══════════════════════════════════════════════════════
     PRINT / AUDIT DOCUMENT — completely separate layout
     Hidden on screen, shown only when printing
════════════════════════════════════════════════════════ -->
<div class="print-only">

    <!-- Document header -->
    <div class="p-header">
        <div class="p-header-left">
            <div class="p-logo">CarbonTrack</div>
            <div class="p-doc-type">Carbon Emissions Audit Report</div>
        </div>
        <div class="p-header-right">
            <div class="p-meta-row"><span class="p-meta-label">Generated</span><span>@now.ToString("dd MMMM yyyy HH:mm") UTC</span></div>
            <div class="p-meta-row"><span class="p-meta-label">Framework</span><span>DEFRA 2025 GHG Conversion Factors</span></div>
            <div class="p-meta-row"><span class="p-meta-label">Scope</span><span>Scope 3 Category 6 &amp; 7 — Business Travel</span></div>
        </div>
    </div>

    <div class="p-rule"></div>

    <!-- Executive summary -->
    <div class="p-section-title">Executive Summary</div>
    <div class="p-summary-grid">
        <div class="p-kpi">
            <div class="p-kpi-val">@ViewBag.TotalTCO2e</div>
            <div class="p-kpi-label">Total tCO₂e</div>
        </div>
        <div class="p-kpi">
            <div class="p-kpi-val">@ViewBag.TotalTrips</div>
            <div class="p-kpi-label">Business trips</div>
        </div>
        <div class="p-kpi">
            <div class="p-kpi-val">@(((double)ViewBag.TotalKm).ToString("N0"))</div>
            <div class="p-kpi-label">Total km</div>
        </div>
        <div class="p-kpi">
            <div class="p-kpi-val">@ViewBag.FlightTCO2e</div>
            <div class="p-kpi-label">Flight tCO₂e</div>
        </div>
        <div class="p-kpi">
            <div class="p-kpi-val">@ViewBag.TrainTCO2e</div>
            <div class="p-kpi-label">Rail tCO₂e</div>
        </div>
        <div class="p-kpi">
            <div class="p-kpi-val">@ViewBag.CarTCO2e</div>
            <div class="p-kpi-label">Car/Taxi/Ferry tCO₂e</div>
        </div>
    </div>

    <!-- Compliance statement -->
    <div class="p-compliance">
        <strong>Compliance Statement.</strong>
        This report has been prepared in accordance with the UK Government's Department for Environment, Food &amp; Rural Affairs (DEFRA) 2025 Greenhouse Gas (GHG) Conversion Factors for Company Reporting. All flight distances are calculated using the Haversine Great Circle formula, consistent with DEFRA methodology for air travel. Road and rail distances are sourced from the Google Maps Distance Matrix API. This report is aligned with the Streamlined Energy and Carbon Reporting (SECR) framework and PPN 06/21 guidance for public sector organisations. All emission factors are expressed in kgCO₂e per kilometre and sourced from DEFRA Table 5 — Business Travel.
    </div>

    <!-- Emissions by mode -->
    <div class="p-section-title" style="margin-top:18px">Emissions by Transport Mode</div>
    <table class="p-table">
        <thead>
            <tr>
                <th>Transport Mode</th>
                <th class="p-right">Trips</th>
                <th class="p-right">Total km</th>
                <th class="p-right">EF (kgCO₂e/km)</th>
                <th class="p-right">kgCO₂e</th>
                <th class="p-right">tCO₂e</th>
                <th class="p-right">% Share</th>
            </tr>
        </thead>
        <tbody>
            @{
                double pTotalKg = trips.Sum(t => t.KgCO2e);
            }
            @foreach (ModeRow row in (ViewBag.ModeBreakdown ?? new List<ModeRow>()))
            {
                double pPct = pTotalKg > 0 ? Math.Round(row.TotalKg / pTotalKg * 100, 1) : 0;
                <tr>
                    <td>@row.Mode</td>
                    <td class="p-right">@row.Count</td>
                    <td class="p-right">@row.TotalKm.ToString("N1")</td>
                    <td class="p-right">@row.AvgFactor</td>
                    <td class="p-right p-bold">@row.TotalKg.ToString("N2")</td>
                    <td class="p-right p-bold">@row.TotalT</td>
                    <td class="p-right">@pPct%</td>
                </tr>
            }
            <tr class="p-total-row">
                <td><strong>TOTAL</strong></td>
                <td class="p-right"><strong>@ViewBag.TotalTrips</strong></td>
                <td class="p-right"><strong>@(((double)ViewBag.TotalKm).ToString("N0"))</strong></td>
                <td class="p-right">—</td>
                <td class="p-right"><strong>@(Math.Round(pTotalKg, 2).ToString("N2"))</strong></td>
                <td class="p-right"><strong>@ViewBag.TotalTCO2e</strong></td>
                <td class="p-right"><strong>100%</strong></td>
            </tr>
        </tbody>
    </table>

    <!-- Full trip audit log -->
    <div class="p-section-title p-page-break" style="margin-top:24px">Full Trip Audit Log</div>
    <table class="p-table p-table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Origin</th>
                <th>Destination</th>
                <th>Mode</th>
                <th class="p-right">Pax</th>
                <th class="p-right">km</th>
                <th class="p-right">EF</th>
                <th class="p-right">kgCO₂e</th>
                <th>Methodology</th>
                <th>DEFRA</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in trips)
            {
                <tr>
                    <td style="white-space:nowrap">@t.TripDate.ToString("dd/MM/yyyy")</td>
                    <td>@t.Origin</td>
                    <td>@t.Destination</td>
                    <td style="font-size:7pt">@t.TransportMode</td>
                    <td class="p-right">@t.Passengers</td>
                    <td class="p-right">@t.DistanceKm.ToString("N2")</td>
                    <td class="p-right">@t.EmissionFactor</td>
                    <td class="p-right p-bold">@t.KgCO2e.ToString("N2")</td>
                    <td style="font-size:7pt">@t.DistanceMethodology</td>
                    <td style="font-size:7pt">@t.DefraFactorYear</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Print footer -->
    <div class="p-footer">
        <span>CarbonTrack · DEFRA 2025 Audit Report · Generated @now.ToString("dd MMM yyyy")</span>
        <span>Scope 3 Category 6 &amp; 7 — Business Travel Emissions</span>
    </div>

</div><!-- end print-only -->


<style>
    /* ── Screen-only styles ── */
    .screen-only { display: block; }
    .print-only  { display: none; }

    .xbtn { padding:8px 14px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block;font-family:'DM Sans',sans-serif;transition:opacity .15s;border:none; }
    .xbtn:hover { opacity:.75; }
    .xbtn-green { background:var(--scl);color:#8aac87;border:1px solid rgba(92,122,90,0.3); }
    .xbtn-lv    { background:var(--lvl);color:var(--lv);border:1px solid var(--bda); }
    .xbtn-ghost { background:rgba(255,255,255,0.05);color:var(--txm);border:1px solid var(--bd); }

    /* ── Print document styles ── */
    @@media print {
        @@page {
            size: A4;
            margin: 18mm 15mm 22mm 15mm;
        }

        .screen-only { display: none !important; }
        .print-only  { display: block !important; }

        /* reset app chrome */
        html, body { background: #fff !important; color: #111 !important; font-family: 'Georgia', serif; font-size: 9pt; }
        .nav, .page { all: unset; display: block; }
        .app { display: block; }

        /* header */
        .p-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
        .p-header-left {}
        .p-logo { font-family: 'Georgia', serif; font-size: 18pt; font-weight: bold; color: #1a3a1a; letter-spacing: -0.02em; }
        .p-doc-type { font-size: 10pt; color: #444; margin-top: 2px; letter-spacing: 0.03em; text-transform: uppercase; }
        .p-header-right { text-align: right; }
        .p-meta-row { font-size: 7.5pt; color: #555; margin-bottom: 2px; display: flex; gap: 8px; justify-content: flex-end; }
        .p-meta-label { color: #999; min-width: 70px; text-align: right; }
        .p-rule { border: none; border-top: 2px solid #1a3a1a; margin: 8px 0 14px; }

        /* sections */
        .p-section-title { font-size: 8pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: #1a3a1a; margin-bottom: 6px; border-bottom: 1px solid #ccc; padding-bottom: 3px; }

        /* KPI summary grid */
        .p-summary-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-bottom: 14px; }
        .p-kpi { border: 1px solid #ddd; border-radius: 4px; padding: 8px 10px; text-align: center; }
        .p-kpi-val { font-size: 14pt; font-weight: bold; color: #1a3a1a; line-height: 1.1; }
        .p-kpi-label { font-size: 7pt; color: #666; margin-top: 2px; }

        /* compliance box */
        .p-compliance { background: #f8f8f8; border-left: 3px solid #1a3a1a; padding: 8px 12px; font-size: 7.5pt; color: #333; line-height: 1.5; margin-bottom: 6px; }

        /* tables */
        .p-table { width: 100%; border-collapse: collapse; font-size: 8pt; margin-bottom: 8px; }
        .p-table th { background: #1a3a1a; color: #fff; padding: 5px 7px; text-align: left; font-size: 7pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.04em; }
        .p-table td { padding: 4px 7px; border-bottom: 1px solid #eee; color: #222; vertical-align: top; }
        .p-table tr:nth-child(even) td { background: #f9f9f9; }
        .p-right { text-align: right; }
        .p-bold { font-weight: bold; }
        .p-total-row td { background: #eef4ee !important; border-top: 2px solid #1a3a1a; font-size: 8.5pt; }
        .p-table-sm { font-size: 7.5pt; }
        .p-table-sm td, .p-table-sm th { padding: 3px 5px; }

        /* page break before audit log */
        .p-page-break { page-break-before: always; padding-top: 4px; }

        /* footer */
        .p-footer { position: fixed; bottom: 8mm; left: 15mm; right: 15mm; display: flex; justify-content: space-between; font-size: 7pt; color: #888; border-top: 1px solid #ddd; padding-top: 4px; }
    }
</style>
