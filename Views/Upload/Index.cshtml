@{
    ViewData["Title"] = "Upload Travel Data";
    Layout = "_Layout";
}

@if (ViewBag.Success != null)
{
    <div style="background:rgba(92,122,90,0.15);border:1px solid rgba(92,122,90,0.3);border-radius:8px;padding:14px;margin-bottom:20px;color:#8aac87;font-size:13px;">✓ @ViewBag.Success</div>
}
@if (ViewBag.Error != null)
{
    <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:14px;margin-bottom:20px;color:#fca5a5;font-size:13px;"><strong>Error:</strong> @ViewBag.Error</div>
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px;gap:16px;flex-wrap:wrap">
    <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
            <div style="width:3px;height:32px;background:var(--sc);border-radius:2px"></div>
            <h1 class="page-title" style="margin:0">Upload Travel Data</h1>
        </div>
        <p style="font-size:13px;color:var(--txm);margin-left:13px">
            Import a full year from Excel or CSV · DESNZ 2024 WTW factors applied · CO₂, CH₄, N₂O breakdown included
        </p>
    </div>
    <a href="/Reports" class="btn-primary" style="white-space:nowrap">View reports →</a>
</div>

<!-- ── STEP 1: Upload ─────────────────────────────────────────────────────── -->
<div id="step-upload">

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px">

        <div class="card card-p">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--txm);margin-bottom:12px">Accepted column names</div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px">
                @foreach (var c in new[]{ "Date Out","Date Back","Journey","Mode","Miles","People" })
                {
                    <span style="background:var(--bg3);border:1px solid var(--bd);border-radius:5px;padding:3px 8px;font-size:10px;font-family:monospace;color:var(--lv)">@c</span>
                }
            </div>
            <div style="font-size:11px;color:var(--txs)">
                Journey column e.g. "Plymouth - London" or "London - Dallas - London" (return trips auto-detected).<br>
                Or use separate From/To columns. Miles ÷ 0.621 applied automatically.
            </div>
        </div>

        <div class="card card-p">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--txm);margin-bottom:12px">DESNZ 2024 WTW factors applied</div>
            <table style="font-size:10px;width:100%">
                <thead><tr><th style="text-align:left;color:var(--txs);padding-bottom:4px">Mode</th><th style="text-align:right;color:var(--txs)">WTW kgCO₂e/unit</th><th style="text-align:right;color:var(--txs)">Unit</th></tr></thead>
                <tbody>
                    <tr><td style="padding:2px 0;color:var(--txm)">Domestic flight</td><td style="text-align:right;font-family:monospace;color:var(--lv)">0.30607</td><td style="text-align:right;color:var(--txs)">pax·km</td></tr>
                    <tr><td style="color:var(--txm)">Short-haul flight</td><td style="text-align:right;font-family:monospace;color:var(--lv)">0.20878</td><td style="text-align:right;color:var(--txs)">pax·km</td></tr>
                    <tr><td style="color:var(--txm)">Long-haul flight</td><td style="text-align:right;font-family:monospace;color:var(--lv)">0.29341</td><td style="text-align:right;color:var(--txs)">pax·km</td></tr>
                    <tr><td style="color:var(--txm)">Average car</td><td style="text-align:right;font-family:monospace;color:var(--lv)">0.21090</td><td style="text-align:right;color:var(--txs)">veh·km</td></tr>
                    <tr><td style="color:var(--txm)">National Rail</td><td style="text-align:right;font-family:monospace;color:var(--lv)">0.04443</td><td style="text-align:right;color:var(--txs)">pax·km</td></tr>
                </tbody>
            </table>
            <div style="font-size:10px;color:var(--txs);margin-top:8px">Car = vehicle-km (no passenger multiplier). Planes/Rail = passenger-km.</div>
        </div>

    </div>

    <div id="drop-zone" onclick="document.getElementById('file-input').click()">
        <div style="font-size:32px;margin-bottom:12px;opacity:.5">📂</div>
        <div style="font-size:15px;font-weight:600;color:var(--tx);margin-bottom:6px">Drop Excel or CSV here</div>
        <div style="font-size:12px;color:var(--txm);margin-bottom:16px">.xlsx or .csv · max 10 MB</div>
        <div class="btn-primary" style="display:inline-block;pointer-events:none">Choose file</div>
        <input type="file" id="file-input" accept=".xlsx,.csv" style="display:none">
    </div>

    <div id="parse-progress" style="display:none;text-align:center;padding:40px;color:var(--txm)">
        <div class="upload-spinner"></div>
        <div style="margin-top:12px;font-size:13px">Parsing and calculating emissions…</div>
    </div>

    <div id="parse-error" style="display:none;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:14px;margin-top:16px;color:#fca5a5;font-size:13px"></div>

</div>

<!-- ── STEP 2: Preview ────────────────────────────────────────────────────── -->
<div id="step-preview" style="display:none">

    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:20px">
        <div class="stat-card"><div class="stat-label">Total rows</div><div class="stat-val" id="sum-total">0</div></div>
        <div class="stat-card" style="border-color:rgba(92,122,90,0.4)"><div class="stat-label">Ready</div><div class="stat-val" id="sum-ready" style="color:#8aac87">0</div></div>
        <div class="stat-card" style="border-color:rgba(197,180,227,0.3)"><div class="stat-label">Review</div><div class="stat-val" id="sum-review" style="color:var(--lv)">0</div></div>
        <div class="stat-card" style="border-color:rgba(239,68,68,0.2)"><div class="stat-label">Gaps</div><div class="stat-val" id="sum-gap" style="color:#fca5a5">0</div></div>
        <div class="stat-card"><div class="stat-label">kgCO₂e</div><div class="stat-val" id="sum-kg" style="font-size:18px">0</div></div>
        <div class="stat-card" style="border-color:var(--bda)"><div class="stat-label">tCO₂e</div><div class="stat-val" id="sum-t" style="color:var(--lv)">0</div></div>
    </div>

    <div id="gap-banner" style="display:none;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:12px;color:#fca5a5">
        <strong style="color:#fff">Gap analysis:</strong> <span id="gap-detail"></span>
        — shown in red below. Fix the source file and re-upload to include them.
    </div>

    <div style="display:flex;gap:8px;margin-bottom:12px">
        <button class="ftab active" data-filter="all">All</button>
        <button class="ftab" data-filter="ready">Ready ✓</button>
        <button class="ftab" data-filter="needsreview">Needs review</button>
        <button class="ftab" data-filter="gap">Gaps ✗</button>
    </div>

    <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:14px;overflow:hidden;margin-bottom:20px">
        <div style="overflow-x:auto">
            <table id="preview-table" style="min-width:1200px">
                <thead><tr>
                    <th>#</th><th></th><th>Date</th><th>Journey</th>
                    <th>Mode</th><th>Pax</th><th>Miles</th><th>km</th>
                    <th>WTW EF</th><th>Unit</th>
                    <th>kgCO₂e</th><th>kgCO₂</th><th>kgCH₄</th><th>kgN₂O</th>
                    <th>Year</th><th>Issues</th>
                </tr></thead>
                <tbody id="preview-body"></tbody>
            </table>
        </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
        <button onclick="resetUpload()" style="background:transparent;border:1px solid var(--bd);border-radius:8px;padding:10px 18px;color:var(--txm);font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif">← Upload different file</button>
        <div style="display:flex;align-items:center;gap:12px">
            <span id="import-summary" style="font-size:12px;color:var(--txm)"></span>
            <button id="btn-import" onclick="confirmImport()" class="btn-submit" style="width:auto;padding:10px 28px">Import →</button>
        </div>
    </div>
</div>

<!-- ── STEP 3: Done ───────────────────────────────────────────────────────── -->
<div id="step-done" style="display:none">
    <div class="card card-p" style="text-align:center;padding:56px">
        <div style="font-size:48px;margin-bottom:16px">✅</div>
        <div style="font-family:'DM Serif Display',serif;font-size:28px;margin-bottom:8px;color:var(--tx)">Import complete</div>
        <div id="done-detail" style="font-size:14px;color:var(--txm);margin-bottom:28px"></div>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a href="/Reports" class="btn-primary">View audit report →</a>
            <a href="/Trip" class="btn-back" style="width:auto;padding:10px 20px">Trip log</a>
            <button onclick="resetUpload()" class="btn-back" style="width:auto;padding:10px 20px">Upload another</button>
        </div>
    </div>
</div>

<div style="margin-top:28px;border-top:1px solid var(--bd);padding-top:20px">
    <div class="info-box" style="margin-bottom:0">
        <strong>Calculation rules applied.</strong>
        Distance: miles ÷ 0.621.
        Car = vehicle-km (no passenger multiplier — a car burns the same fuel with 1 or 4 people).
        Flights &amp; Rail = passenger-km (multiplied by people).
        Return trips (e.g. "London – Frankfurt – London") detected automatically — one-way distance used for haul classification.
        DESNZ 2024 WTW factors = TTW (combustion) + WTT (upstream). CO₂, CH₄ and N₂O reported separately for SECR.
    </div>
</div>

<style>
#drop-zone{border:2px dashed var(--bd);border-radius:14px;padding:48px 24px;text-align:center;cursor:pointer;transition:all .2s;background:var(--bg2)}
#drop-zone:hover,#drop-zone.drag-over{border-color:var(--sc);background:rgba(92,122,90,0.07)}
.upload-spinner{width:32px;height:32px;border:3px solid var(--bd);border-top-color:var(--lv);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto}
@@keyframes spin{to{transform:rotate(360deg)}}
.ftab{padding:6px 14px;border-radius:7px;font-size:12px;font-weight:500;border:1px solid var(--bd);background:transparent;color:var(--txm);cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .15s}
.ftab.active{background:var(--scl);color:var(--tx);border-color:rgba(92,122,90,0.3)}
.row-gap td{background:rgba(239,68,68,0.04);color:rgba(255,255,255,0.4)}
.issue-pill{display:inline-block;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.2);color:#fca5a5;border-radius:4px;padding:1px 6px;font-size:9px;margin:1px 2px}
.warn-pill{display:inline-block;background:rgba(197,180,227,0.1);border:1px solid rgba(197,180,227,0.2);color:var(--lv);border-radius:4px;padding:1px 6px;font-size:9px;margin:1px 2px}
.return-badge{display:inline-block;background:rgba(92,122,90,0.15);color:#8aac87;border-radius:3px;padding:1px 5px;font-size:9px;margin-left:4px}
</style>

<script>
let parsedRows = [];
let currentFilter = 'all';

const fileInput = document.getElementById('file-input');
const dropZone  = document.getElementById('drop-zone');

fileInput.addEventListener('change', () => { if (fileInput.files[0]) parseFile(fileInput.files[0]); });
dropZone.addEventListener('dragover',  e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
dropZone.addEventListener('drop', e => {
    e.preventDefault(); dropZone.classList.remove('drag-over');
    if (e.dataTransfer.files[0]) parseFile(e.dataTransfer.files[0]);
});

async function parseFile(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    if (ext !== 'xlsx' && ext !== 'csv') { showErr('Only .xlsx and .csv files are supported.'); return; }

    dropZone.style.display           = 'none';
    document.getElementById('parse-progress').style.display = 'flex';
    document.getElementById('parse-error').style.display    = 'none';

    const fd = new FormData();
    fd.append('file', file);

    try {
        const res  = await fetch('/Upload/Parse', { method: 'POST', body: fd });
        const data = await res.json();
        document.getElementById('parse-progress').style.display = 'none';

        if (!data.success) { showErr(data.error); return; }

        parsedRows = data.rows;
        renderPreview(data);
        document.getElementById('step-upload').style.display  = 'none';
        document.getElementById('step-preview').style.display = 'block';
    } catch(e) {
        document.getElementById('parse-progress').style.display = 'none';
        showErr('Network error: ' + e.message);
    }
}

function showErr(msg) {
    dropZone.style.display = 'block';
    const el = document.getElementById('parse-error');
    el.textContent = msg; el.style.display = 'block';
}

function renderPreview(data) {
    document.getElementById('sum-total').textContent  = data.rows.length;
    document.getElementById('sum-ready').textContent  = data.readyCount;
    document.getElementById('sum-review').textContent = data.reviewCount;
    document.getElementById('sum-gap').textContent    = data.gapCount;
    document.getElementById('sum-kg').textContent     = data.totalKgCO2e.toFixed(2);
    document.getElementById('sum-t').textContent      = data.totalTCO2e.toFixed(4);

    if (data.gapCount > 0) {
        document.getElementById('gap-banner').style.display = 'block';
        document.getElementById('gap-detail').textContent   =
            `${data.gapCount} row${data.gapCount > 1 ? 's' : ''} cannot be imported`;
    }

    const importable = data.readyCount + data.reviewCount;
    document.getElementById('import-summary').textContent =
        `${importable} rows to import · ${data.gapCount} gaps skipped`;

    renderTable();
}

function renderTable() {
    const tbody    = document.getElementById('preview-body');
    tbody.innerHTML = '';
    const filtered = currentFilter === 'all'
        ? parsedRows
        : parsedRows.filter(r => r.status === currentFilter);

    filtered.forEach(r => {
        const tr = document.createElement('tr');
        if (r.status === 'gap') tr.className = 'row-gap';

        const icon = r.status === 'ready'
            ? '<span style="color:#8aac87;font-weight:700">✓</span>'
            : r.status === 'needsreview'
                ? '<span style="color:var(--lv)">⚠</span>'
                : '<span style="color:#fca5a5">✗</span>';

        const modeTag = r.transportMode
            ? `<span class="tag ${r.transportMode.startsWith('Flight') ? 'tag-flight' : r.transportMode.startsWith('Train') ? 'tag-train' : 'tag-car'}" style="font-size:9px">${r.transportMode}</span>`
            : `<span style="color:#fca5a5;font-size:10px">${r.rawMode||'—'}</span>`;

        const unitBadge = r.isVehicleKm
            ? '<span style="font-size:9px;color:var(--txs);background:var(--bg3);padding:1px 5px;border-radius:3px">veh·km</span>'
            : '<span style="font-size:9px;color:var(--txs);background:var(--bg3);padding:1px 5px;border-radius:3px">pax·km</span>';

        const journey = r.rawJourney || `${r.origin} → ${r.destination}`;
        const returnBadge = r.isReturnTrip ? '<span class="return-badge">↩ return</span>' : '';

        const issueHtml = (r.issues||[]).map(i =>
            i.toLowerCase().includes('missing') || i.toLowerCase().includes('not recog')
                ? `<span class="issue-pill">${i}</span>`
                : `<span class="warn-pill">${i}</span>`
        ).join('');

        tr.innerHTML = `
            <td class="mono" style="color:var(--txs)">${r.sourceRow}</td>
            <td style="text-align:center">${icon}</td>
            <td style="white-space:nowrap;color:var(--txm)">${r.tripDateFmt||'—'}</td>
            <td style="font-size:11px;white-space:nowrap"><strong>${journey}</strong>${returnBadge}</td>
            <td>${modeTag}</td>
            <td class="mono">${r.passengers}</td>
            <td class="mono">${r.distanceMiles > 0 ? r.distanceMiles.toFixed(1) : '—'}</td>
            <td class="mono">${r.distanceKm > 0 ? r.distanceKm.toFixed(2) : '—'}</td>
            <td class="mono" style="font-size:10px">${r.emissionFactor > 0 ? r.emissionFactor.toFixed(5) : '—'}</td>
            <td>${unitBadge}</td>
            <td class="co2">${r.kgCO2e > 0 ? r.kgCO2e.toFixed(2) : '—'}</td>
            <td class="mono" style="font-size:10px">${r.kgCO2 > 0 ? r.kgCO2.toFixed(4) : '—'}</td>
            <td class="mono" style="font-size:10px">${r.kgCH4 > 0 ? r.kgCH4.toFixed(6) : '—'}</td>
            <td class="mono" style="font-size:10px">${r.kgN2O > 0 ? r.kgN2O.toFixed(6) : '—'}</td>
            <td><span class="ok-badge" style="font-size:9px">${r.defraYear||'—'}</span></td>
            <td style="max-width:200px">${issueHtml||'<span style="color:var(--txs);font-size:10px">—</span>'}</td>
        `;
        tbody.appendChild(tr);
    });
}

document.querySelectorAll('.ftab').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.ftab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter;
        renderTable();
    });
});

async function confirmImport() {
    const importable = parsedRows.filter(r => r.status !== 'gap');
    if (!importable.length) { alert('No importable rows.'); return; }

    const btn = document.getElementById('btn-import');
    btn.disabled = true; btn.textContent = 'Importing…';

    const rows = importable.map(r => ({
        tripDate:      r.tripDate,
        origin:        r.origin,
        destination:   r.destination,
        transportMode: r.transportMode,
        travelClass:   r.travelClass,
        passengers:    r.passengers,
        distanceKm:    r.distanceKm,
        methodology:   r.methodology,
    }));

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const res   = await fetch('/Upload/Confirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ rows }),
        });
        const data = await res.json();

        if (data.success) {
            document.getElementById('step-preview').style.display = 'none';
            document.getElementById('step-done').style.display    = 'block';
            document.getElementById('done-detail').innerHTML =
                `<strong style="color:var(--tx)">${data.imported} trips</strong> imported &middot; ` +
                `<strong style="color:var(--lv)">${data.tCO2e} tCO₂e</strong> (${data.kgCO2e} kgCO₂e) &middot; DESNZ 2024 WTW`;
        } else {
            btn.disabled = false; btn.textContent = 'Import →';
            alert('Import failed: ' + data.error);
        }
    } catch(e) {
        btn.disabled = false; btn.textContent = 'Import →';
        alert('Network error: ' + e.message);
    }
}

function resetUpload() {
    parsedRows = []; fileInput.value = '';
    document.getElementById('step-upload').style.display  = 'block';
    document.getElementById('step-preview').style.display = 'none';
    document.getElementById('step-done').style.display    = 'none';
    document.getElementById('drop-zone').style.display    = 'block';
    document.getElementById('parse-error').style.display  = 'none';
    document.getElementById('btn-import').disabled        = false;
    document.getElementById('btn-import').textContent     = 'Import →';
    document.getElementById('gap-banner').style.display   = 'none';
}
</script>

@Html.AntiForgeryToken()
