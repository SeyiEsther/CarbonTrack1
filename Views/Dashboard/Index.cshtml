@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
    var org = ViewBag.Org as CarbonTrack.Models.Organisation;
    bool isConsultant = org?.UserType == "Consultant";
    bool isGovt       = org?.UserType == "Government";
}

@if (ViewBag.Success != null)
{
    <div style="background:rgba(92,122,90,0.15);border:1px solid rgba(92,122,90,0.3);border-radius:8px;padding:14px;margin-bottom:20px;color:#8aac87;font-size:13px;">
        ✓ @ViewBag.Success
    </div>
}
@if (ViewBag.Error != null)
{
    <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:14px;margin-bottom:20px;color:#fca5a5;font-size:13px;">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

@if (ViewBag.ShowOnboarding == true)
{
    <div style="background:var(--lvl);border:1px solid var(--bda);border-radius:12px;padding:18px 22px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--tx);margin-bottom:3px">Set up your profile to personalise your dashboard</div>
            <div style="font-size:12px;color:var(--txm)">Select your user type, sector, and compliance requirements. Takes 60 seconds.</div>
        </div>
        <a href="/Onboarding" class="btn-primary" style="white-space:nowrap">Set up profile →</a>
    </div>
}

<div class="mb-6" style="display:flex;align-items:center;justify-content:space-between">
    <div>
        <h1 class="page-title">
            @if (isConsultant)     { <text>Client Overview</text> }
            else if (isGovt)       { <text>CRP Dashboard</text>   }
            else                   { <text>Dashboard</text>       }
        </h1>
        <p class="page-sub">
            @if (org != null && org.OnboardingComplete)
            {
                <text>@org.UserTypeLabel · @(org.Sector ?? "All sectors") · Scope 3 Category 6 &amp; 7</text>
            }
            else
            {
                <text>Scope 3 Category 6 &amp; 7 — current reporting period</text>
            }
        </p>
    </div>
    <div style="display:flex;gap:8px">
        @if (isConsultant)
        {
            <a href="/Clients" class="btn-primary">Manage clients →</a>
        }
        else
        {
            <a href="/Trip/LogTrip" class="btn-primary">+ Log trip</a>
        }
    </div>
</div>

@* Consultant mode: client summary strip *@
@if (isConsultant)
{
    <div class="info-box mb-6">
        <strong>Consultant view.</strong> You are managing emissions data on behalf of client organisations.
        Use the <a href="/Clients" style="color:var(--tx)">Clients</a> page to manage organisations,
        <a href="/Upload" style="color:var(--tx)">Upload</a> to bulk-import client travel data,
        and <a href="/Reports" style="color:var(--tx)">Reports</a> to generate audit-ready documents.
    </div>
}

@* Government mode: CRP status bar *@
@if (isGovt)
{
    <div style="background:var(--lvl);border:1px solid var(--bda);border-radius:12px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
        <div style="font-size:12px;color:var(--lv)"><strong style="color:var(--tx)">PPN 06/21 status:</strong> Scope 3 Cat 6 data is being tracked. <a href="/Reports" style="color:var(--lv)">Generate CRP section →</a></div>
        <div style="display:flex;gap:8px">
            <span style="background:rgba(92,122,90,0.2);border:1px solid rgba(92,122,90,0.3);color:#8aac87;border-radius:20px;padding:3px 10px;font-size:10px;font-weight:600">✓ Audit trail active</span>
            <span style="background:rgba(92,122,90,0.2);border:1px solid rgba(92,122,90,0.3);color:#8aac87;border-radius:20px;padding:3px 10px;font-size:10px;font-weight:600">✓ DEFRA factors applied</span>
        </div>
    </div>
}

<!-- HERO -->
<div style="background:var(--bg2);border:1px solid var(--bd);border-radius:16px;padding:28px 32px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden" class="mb-6">
    <div style="position:absolute;top:-60px;right:-60px;width:200px;height:200px;background:radial-gradient(ellipse,rgba(197,180,227,0.06) 0%,transparent 70%)"></div>
    <div>
        <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--txm);margin-bottom:8px">Total Scope 3 Category 6 & 7</div>
        <div style="font-family:'DM Serif Display',serif;font-size:56px;color:var(--tx);line-height:1;margin-bottom:4px">@ViewBag.TotalTCO2e</div>
        <div style="font-size:13px;color:var(--txm)">tCO₂e · current period</div>
    </div>
    <div style="display:flex;gap:32px">
        <div style="text-align:right">
            <div style="font-size:10px;color:var(--txm);margin-bottom:4px">Flight emissions</div>
            <div style="font-size:20px;font-weight:500;color:var(--lv)">@ViewBag.FlightEmissions t</div>
        </div>
        <div style="text-align:right">
            <div style="font-size:10px;color:var(--txm);margin-bottom:4px">Trips logged</div>
            <div style="font-size:20px;font-weight:500;color:var(--lv)">@ViewBag.TotalTrips</div>
        </div>
    </div>
</div>

<!-- STATS -->
<div class="grid-3 mb-6">
    <div class="stat-card">
        <div class="stat-label">Flights</div>
        <div class="stat-val">@ViewBag.FlightCount</div>
        <div class="stat-sub">@ViewBag.FlightEmissions tCO₂e</div>
        <div class="stat-bar"><div class="stat-fill" style="width:70%;background:var(--lv)"></div></div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Rail</div>
        <div class="stat-val">@ViewBag.TrainCount</div>
        <div class="stat-sub">@ViewBag.TrainEmissions tCO₂e</div>
        <div class="stat-bar"><div class="stat-fill" style="width:50%;background:var(--sc)"></div></div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Car / Taxi / Ferry</div>
        <div class="stat-val">@ViewBag.CarCount</div>
        <div class="stat-sub">@ViewBag.CarEmissions tCO₂e</div>
        <div class="stat-bar"><div class="stat-fill" style="width:40%;background:rgba(255,255,255,0.2)"></div></div>
    </div>
</div>

@* Intensity metrics row — shown when org has employee/turnover data *@
@if (ViewBag.IntensityPerEmployee != null || ViewBag.IntensityPerMGBP != null)
{
    <div class="grid-2 mb-6">
        @if (ViewBag.IntensityPerEmployee != null)
        {
            <div class="stat-card" style="border-color:var(--bda)">
                <div class="stat-label">tCO₂e per employee</div>
                <div class="stat-val" style="color:var(--lv)">@ViewBag.IntensityPerEmployee</div>
                <div class="stat-sub">intensity metric (SECR)</div>
            </div>
        }
        @if (ViewBag.IntensityPerMGBP != null)
        {
            <div class="stat-card" style="border-color:var(--bda)">
                <div class="stat-label">tCO₂e per £m turnover</div>
                <div class="stat-val" style="color:var(--lv)">@ViewBag.IntensityPerMGBP</div>
                <div class="stat-sub">intensity metric (SECR)</div>
            </div>
        }
    </div>
}

@* Gas breakdown — shown when DESNZ-uploaded data exists *@
@if ((double)(ViewBag.TotalKgCO2 ?? 0) > 0)
{
    <div style="background:var(--bg2);border:1px solid var(--bd);border-radius:12px;padding:16px 20px;margin-bottom:20px">
        <div class="section-title" style="margin-bottom:12px">Gas breakdown (DESNZ WTW)</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
            <div><div style="font-size:10px;color:var(--txm);margin-bottom:3px">CO₂</div><div style="font-size:18px;font-weight:600;font-family:monospace">@(((double)ViewBag.TotalKgCO2).ToString("N2")) kg</div></div>
            <div><div style="font-size:10px;color:var(--txm);margin-bottom:3px">CH₄</div><div style="font-size:18px;font-weight:600;font-family:monospace">@(((double)ViewBag.TotalKgCH4).ToString("N4")) kg</div></div>
            <div><div style="font-size:10px;color:var(--txm);margin-bottom:3px">N₂O</div><div style="font-size:18px;font-weight:600;font-family:monospace">@(((double)ViewBag.TotalKgN2O).ToString("N4")) kg</div></div>
        </div>
    </div>
}

<!-- CHART + COMPLIANCE -->
<div style="display:grid;grid-template-columns:1fr 220px;gap:16px;margin-bottom:20px">
    <div class="card card-p">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
            <div>
                <div class="section-title" style="margin:0">Monthly emissions</div>
                <div style="font-size:11px;color:var(--txm);margin-top:2px">tCO₂e by transport mode — last 12 months</div>
            </div>
            <div style="display:flex;gap:12px">
                <div style="display:flex;align-items:center;gap:5px;font-size:10px;color:var(--txm)"><div style="width:7px;height:7px;border-radius:2px;background:var(--sc)"></div>Flights</div>
                <div style="display:flex;align-items:center;gap:5px;font-size:10px;color:var(--txm)"><div style="width:7px;height:7px;border-radius:2px;background:var(--lv)"></div>Rail</div>
                <div style="display:flex;align-items:center;gap:5px;font-size:10px;color:var(--txm)"><div style="width:7px;height:7px;border-radius:2px;background:rgba(255,255,255,0.2)"></div>Car</div>
            </div>
        </div>
        <div id="bar-chart" style="display:flex;align-items:flex-end;gap:6px;height:90px"></div>
    </div>

    <div class="card card-p">
        <div class="section-title mb-4">Compliance</div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bd)"><span style="font-size:12px;color:var(--tx)">DEFRA factors</span><span class="ok-badge">2025 ✓</span></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bd)"><span style="font-size:12px;color:var(--tx)">Flights</span><span class="lv-badge">Haversine ✓</span></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bd)"><span style="font-size:12px;color:var(--tx)">Road & rail</span><span class="lv-badge">Maps API ✓</span></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bd)"><span style="font-size:12px;color:var(--tx)">SECR</span><span class="ok-badge">Aligned ✓</span></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bd)"><span style="font-size:12px;color:var(--tx)">PPN 06/21</span><span class="ok-badge">Ready ✓</span></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0"><span style="font-size:12px;color:var(--tx)">Audit trail</span><span class="ok-badge">100% ✓</span></div>
    </div>
</div>

<!-- RECENT TRIPS -->
<div class="card">
    <div class="card-p" style="border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between">
        <span class="section-title" style="margin:0">Recent trips</span>
        <a href="/Trip" style="font-size:11px;color:var(--lv);font-weight:600;text-decoration:none">View all →</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Route</th>
                <th>Mode</th>
                <th>Distance</th>
                <th>Formula</th>
                <th>kgCO₂e</th>
                <th>Audit</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.RecentTrips != null && ((IEnumerable<CarbonTrack.Models.Trip>)ViewBag.RecentTrips).Any())
            {
                foreach (var trip in (IEnumerable<CarbonTrack.Models.Trip>)ViewBag.RecentTrips)
                {
                    <tr>
                        <td style="color:var(--txm)">@trip.TripDate.ToString("dd MMM yyyy")</td>
                        <td><b>@trip.Origin → @trip.Destination</b></td>
                        <td>
                            <span class="tag @(trip.TransportMode.StartsWith("Flight") ? "tag-flight" : trip.TransportMode.StartsWith("Train") ? "tag-train" : "tag-car")">
                                @trip.TransportMode
                            </span>
                        </td>
                        <td class="mono">@trip.DistanceKm km</td>
                        <td class="mono">@trip.Formula</td>
                        <td class="co2">@trip.KgCO2e</td>
                        <td><span class="ok-badge">✓ 2025</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align:center;padding:40px;color:var(--txm)">
                        No trips logged yet — <a href="/Trip/LogTrip" style="color:var(--lv)">log your first trip</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
(function () {
    const data = @Html.Raw(ViewBag.MonthlyData ?? "[]");
    const chart = document.getElementById('bar-chart');
    if (!chart || !data.length) return;

    const maxVal = Math.max(...data.map(d => d.Flights + d.Rail + d.Car), 0.001);
    const BAR_H = 78;

    chart.innerHTML = data.map(d => {
        const total = d.Flights + d.Rail + d.Car;
        const flightH = Math.round((d.Flights / maxVal) * BAR_H);
        const railH = Math.round((d.Rail / maxVal) * BAR_H);
        const carH = Math.round((d.Car / maxVal) * BAR_H);
        const tip = total > 0
            ? `${d.Label}: ${total.toFixed(3)} tCO₂e (F:${d.Flights} R:${d.Rail} C:${d.Car})`
            : `${d.Label}: no trips`;
        return `<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px" title="${tip}">
            <div style="width:100%;display:flex;flex-direction:column;justify-content:flex-end;height:${BAR_H}px;gap:1px">
                <div style="height:${carH}px;background:rgba(255,255,255,0.15);border-radius:2px 2px 0 0;min-height:${carH > 0 ? 2 : 0}px"></div>
                <div style="height:${railH}px;background:var(--lv);border-radius:2px 2px 0 0;min-height:${railH > 0 ? 2 : 0}px"></div>
                <div style="height:${flightH}px;background:var(--sc);border-radius:2px 2px 0 0;min-height:${flightH > 0 ? 2 : 0}px"></div>
            </div>
            <span style="font-size:9px;color:var(--txm)">${d.Label}</span>
        </div>`;
    }).join('');
})();
</script>
